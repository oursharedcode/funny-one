# ---------------------------------------------------------------------------
# Funny Multi «Чепуха 37» — game server environment (design.md §11)
# Copy to .env for local development. Never commit .env.
# ---------------------------------------------------------------------------

# Required for image generation. Deploy the Cloudflare Worker first
# (see docs/DEPLOYMENT.md -> Deploying the Cloudflare Worker; until that doc is
# written at T-8.3, cloudflare/wrangler.toml carries the steps). Note the
# Worker needs its R2 bucket to exist before the first deploy:
#   wrangler r2 bucket create funny-multi-images
CLOUDFLARE_WORKER_URL=
CLOUDFLARE_WORKER_SECRET=

# Optional: if set, the end screen shows a "Support this server" button linking here.
# Donations go to YOU (the operator), not the upstream author. Leave unset for no button.
# The client never hardcodes any donation URL (FM-TIER-4 / MON-7).
DEPLOYER_DONATE_URL=

# Optional: concurrent room ceiling per process. Default 500 if unset. (FM-CORE-4)
# MAX_ROOMS=500

# Optional: daily Cloudflare AI image ceiling per server process. Default 25 if
# unset. R2 cache hits do NOT consume the cap (FM-TIER-1).
# MAX_IMAGES_PER_DAY=25

# Optional: round timer in milliseconds. Default 60000 if unset. (FM-CORE-7)
# ROUND_DURATION_MS=60000

# Optional: server port. Default 3000 if unset.
# PORT=3000

# Optional: URL sub-path the app is served under, for a reverse proxy that
# routes e.g. https://host/funny37-game/ to this process (requirements D-5).
# Default "/" = served at the root (Render). Reaches TWO places: the client
# build bakes it in (Vite base, PWA scope, Socket.IO path) and the server reads
# it at runtime (static prefix, /health, Socket.IO path) — docker-compose.yml
# passes this one value to both; a manual `docker build` needs
# `--build-arg BASE_PATH=…` as well. The app accepts any spelling; write it
# WITHOUT a trailing slash here because the Caddyfile below pastes it verbatim.
# BASE_PATH=/funny37-game

# Only for `docker compose --profile caddy` (deploy/caddy/Caddyfile): the name
# players type, and the bare domain that redirects to it. DNS A records for
# both must point at this host before Caddy can fetch certificates.
# SITE_HOST=www.example.com
# SITE_APEX=example.com

# Optional: number of trusted reverse-proxy hops in front of this process,
# for x-forwarded-for-based rate-limit bucketing (FM-CORE-4). Default 1
# matches Render's single TLS-terminating proxy; raise it only if you put a
# CDN or load balancer in front of Render.
# TRUSTED_PROXY_HOPS=1

# Premium phase only (Phase 9, FM-TIER-3). Shared secret between this server and
# the Worker's /entitlement endpoint; distinct from CLOUDFLARE_WORKER_SECRET.
# Leave unset until Phase 9 — an unset value means no premium rooms.
# ENTITLEMENT_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare Worker secrets — NOT read from this file.
# Set with `wrangler secret put <NAME>` (see cloudflare/wrangler.toml):
#   WORKER_SECRET        must equal CLOUDFLARE_WORKER_SECRET above
#   POLAR_ACCESS_TOKEN   premium phase, license validation
#   ENTITLEMENT_SECRET   premium phase, must equal the value above
# R2 bucket (IMAGES) and KV (STATS_KV) are wrangler.toml bindings, not secrets.
# ---------------------------------------------------------------------------
