{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": "./src",
    "types": ["vite/client"],
    "allowJs": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
