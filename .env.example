# ---------------------------------------------------------------------------
# Funny Multi «Чепуха 37» — game server environment (design.md §11)
# Copy to .env for local development. Never commit .env.
# ---------------------------------------------------------------------------

# Required for image generation. Deploy the Cloudflare Worker first
# (DEPLOYMENT.md -> "1. Deploy the Cloudflare Worker"). Note the Worker needs
# its R2 bucket to exist before the first deploy:
#   wrangler r2 bucket create funny-multi-images
CLOUDFLARE_WORKER_URL=
CLOUDFLARE_WORKER_SECRET=
# The Worker's address is also the public address of the picture library:
# deploy/ship-funny-one.sh reads it from the host's .env and bakes it into Funny
# One's build as VITE_PICTURES_URL, which is what lets that game offer the
# library's cartoons (opt-in — DEPLOYMENT.md 2c). The secret is not involved.

# Optional support rails (design §10.2, FM-TIER-3). Gifts go to YOU (the operator),
# not the upstream author; the client shows only the rails you set and never
# hardcodes an address. Leave all unset for no Support screen and no ♥ on Home.
# Read once at boot and served at <BASE_PATH>/config — restart the server after
# changing them (DEPLOYMENT.md -> "Optional: the Support screen").
# PayID/Osko: the PayID (email/phone/ABN) and the EXACT registered account name
# the payer's bank will display before they confirm — a mismatch makes people abort.
DEPLOYER_PAYID=
DEPLOYER_PAYID_NAME=
# GitHub Sponsors profile URL (create one-time tiers; the flow defaults to monthly).
DEPLOYER_SPONSORS_URL=
# Lightning address (user@wallet), rendered as a lightning: link and a QR code.
DEPLOYER_LIGHTNING_ADDRESS=
# Legacy single "Support this server" link (any URL). Shown last if set.
DEPLOYER_DONATE_URL=

# Optional: concurrent room ceiling per process. Default 500 if unset. (FM-CORE-4)
# MAX_ROOMS=500

# Optional: daily Cloudflare AI image ceiling per server process. Default 25 if
# unset. R2 cache hits do NOT consume the cap (FM-TIER-1).
# MAX_IMAGES_PER_DAY=25

# Optional: round timer in milliseconds. Default 60000 if unset. (FM-CORE-7)
# ROUND_DURATION_MS=60000

# Optional: server port. Default 3000 if unset.
# PORT=3000

# Optional: URL sub-path the app is served under, for a reverse proxy of your own
# that routes e.g. https://host/some-path/ to this process (requirements D-5).
# Default "/" = served at the root of the site name — and the only value the
# Caddy profile below supports: its game host serves the game at the root.
# Reaches TWO places: the client build bakes it in (Vite base, PWA scope,
# Socket.IO path) and the server reads it at runtime (static prefix, /health,
# Socket.IO path) — docker-compose.yml passes this one value to both; a manual
# `docker build` needs `--build-arg BASE_PATH=…` as well. The app accepts any
# spelling.
# BASE_PATH=/some-path

# Only for `docker compose --profile caddy` (deploy/caddy/Caddyfile). Eight
# names, all required there; DNS A records for all eight must point at this
# host before Caddy can fetch certificates.
#   FM_HOST / FM_APEX     Funny Multi's own host (the name players type) and its
#                         bare name, which redirects to it.
#   FO_HOST / FO_APEX     Funny One's own host and its bare name, which redirects
#                         to it (deploy/ship-funny-one.sh puts the game there).
#   SITE_HOST / SITE_APEX the older shared host: the games' former addresses
#                         /funny37-game and /funny1-game forward from it to
#                         FM_HOST and FO_HOST; the bare name redirects to it.
#   HUB_HOST / HUB_APEX   the Funny Family landing page and its bare name, which
#                         redirects to it (deploy/ship-funny-family.sh puts the
#                         page there).
#                         Self-hosting only Funny Multi: any names you control
#                         will do for the last six.
# FM_HOST=www.funny37.example.com
# FM_APEX=funny37.example.com
# FO_HOST=www.funny1.example.com
# FO_APEX=funny1.example.com
# SITE_HOST=www.example.com
# SITE_APEX=example.com
# HUB_HOST=www.funny-family.example.com
# HUB_APEX=funny-family.example.com

# Optional: the file that keeps the anonymous daily visit counts of the website
# and the landing page (design DD-15) across restarts. Unset, they live in
# memory only. docker-compose.yml sets it to a file in its own volume, so leave
# it unset there.
# STATS_FILE=/var/lib/funny/stats.json

# Optional: number of trusted reverse-proxy hops in front of this process,
# for x-forwarded-for-based rate-limit bucketing (FM-CORE-4). Default 1
# matches Caddy (or any single TLS-terminating proxy); raise it only if you
# put a CDN or load balancer in front of that proxy. See DEPLOYMENT.md.
# TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Cloudflare Worker secrets — NOT read from this file.
# Set with `wrangler secret put <NAME>` (see cloudflare/wrangler.toml):
#   WORKER_SECRET        must equal CLOUDFLARE_WORKER_SECRET above
# R2 bucket (IMAGES), KV (STATS_KV) and Workers AI (AI — the generation switch,
# shipped off) are wrangler.toml bindings, not secrets.
# ---------------------------------------------------------------------------
