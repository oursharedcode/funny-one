# Read-only local reference copy of oursharedcode/funny-stories (has its own
# embedded .git and a local .env with secrets) — never committed here.
docs/source_project/

# Dependencies and build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Environment / secrets
.env
.env.local
# Android signing keys live in ~/.android-keys/ (deploy/android/README.md);
# this only catches a stray copy.
*.jks
*.keystore

# Android store apps (B-1d, S-3b): Bubblewrap regenerates the Gradle project and
# the build outputs from twa-manifest.json, so only these two files are tracked
# in each directory.
/deploy/android/*
!/deploy/android/twa-manifest.json
!/deploy/android/README.md
/deploy/android-funny1/*
!/deploy/android-funny1/twa-manifest.json
!/deploy/android-funny1/README.md

# Tooling / OS
.claude/settings.local.json
.vite/
.wrangler/
.screens/
*.log
.DS_Store
Thumbs.db

# Static games streamed to the host by deploy/ship-funny-one.sh (mounted by
# the caddy service); only ever exists on a host, never committed.
/static/

# Phone screenshots and other device-session evidence the owner drops here; the
# acceptance docs record the results, so the images themselves stay local.
local_docs/tests/

# Picture-library review (T-FO-8.2): venv, thumbnails, embeddings — regenerable, never committed
.picture-review/
__pycache__/
