# Funny Family «Чепуха 37» — Caddy in front of the game container (T-8.1,
# requirements D-5; the dedicated hosts are B-1a and Step 60). Used by the
# `caddy` profile in docker-compose.yml:
#
#   docker compose --profile caddy up -d
#
# Caddy terminates TLS (certificates from Let's Encrypt, renewed by itself,
# kept in the `caddy_data` volume), forwards WebSockets without any extra
# directive, and appends the client address to X-Forwarded-For — which is
# why TRUSTED_PROXY_HOPS=1 is right behind it. The eight {$…} values come
# from .env via the compose file:
#   FM_HOST / FM_APEX     Funny Multi's own host and its bare name (redirected
#                         to it). The game sits at that host's root, so the
#                         container's BASE_PATH must be "/".
#   FO_HOST / FO_APEX     Funny One's own host and its bare name (redirected
#                         to it). Static files at that host's root.
#   SITE_HOST / SITE_APEX the older shared host: both games' former addresses
#                         /funny37-game and /funny1-game forward from here to
#                         FM_HOST and FO_HOST.
#   HUB_HOST / HUB_APEX   the Funny Family landing page «Семейная Чепуха» and
#                         its bare name (redirected to it). Static files, plus
#                         the visit counts, which the game's server keeps.

{
	# HTTP/3 needs UDP 443, which the VM's cloud firewall does not open;
	# advertising it would only make browsers probe and fall back.
	servers {
		protocols h1 h2
	}
}

# Funny Multi, at the root of its own host — a Trusted Web Activity's origin
# is baked into the Android app, so the game cannot share a name with another
# game (B-1a). Everything but two paths is forwarded untouched: the container
# serves the static bundle, /health, /config and Socket.IO itself.
{$FM_HOST} {
	encode zstd gzip

	# Origin-root files the game itself does not serve (B-1b), from
	# deploy/origin-root/funny37 in the repo — deploy/ship.sh copies them to
	# ./static/funny37-root. They are answered here because the container's
	# SPA fallback would answer either path with index.html. `handle` blocks
	# are mutually exclusive and tried in the order written, so the proxy
	# below only sees what these two do not match.
	#
	# Digital Asset Links: what lets the Android app open this origin without
	# a URL bar. Google reads it at this exact path — 200, application/json
	# (file_server's type for .json), no redirect. no-cache because its
	# fingerprints change when the signing key does (B-1d).
	handle /.well-known/assetlinks.json {
		header Cache-Control "no-cache"
		root * /srv/static/funny37-root
		file_server
	}

	# The privacy policy, linked from the Play listing. One page holds every
	# language the game offers; no-cache so an edit shows at once.
	@privacy path /privacy /privacy/ /privacy.html
	handle @privacy {
		header Cache-Control "no-cache"
		rewrite * /privacy.html
		root * /srv/static/funny37-root
		file_server
	}

	handle {
		reverse_proxy funny-multi:3000
	}
}

{$FM_APEX} {
	redir https://{$FM_HOST}{uri} permanent
}

# Funny One «Одна Чепуха: по кругу», at the root of its own host (Step 60) —
# for the same reason Funny Multi has one: an Android app's origin is baked
# into it. No container: Caddy serves the static bundle
# deploy/ship-funny-one.sh copies to ./static/funny-one, mounted read-only at
# /srv/static. The script builds with BASE_PATH=/ to match.
{$FO_HOST} {
	encode zstd gzip

	# Origin-root files, from deploy/origin-root/funny1 in the repo — the
	# script copies them to ./static/funny1-root. The same two as on Funny
	# Multi's host above, for the same reason: without these blocks the SPA
	# fallback below would answer either path with index.html.
	handle /.well-known/assetlinks.json {
		header Cache-Control "no-cache"
		root * /srv/static/funny1-root
		file_server
	}

	@privacy path /privacy /privacy/ /privacy.html
	handle @privacy {
		header Cache-Control "no-cache"
		rewrite * /privacy.html
		root * /srv/static/funny1-root
		file_server
	}

	handle {
		# The service worker and the entry files must revalidate on every load
		# or an installed copy can stay pinned to an old build; everything
		# under assets/ is content-hashed and never changes under a given name.
		@fo_entry path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @fo_entry Cache-Control "no-cache"
		@fo_hashed path /assets/*
		header @fo_hashed Cache-Control "public, max-age=31536000, immutable"

		root * /srv/static/funny-one
		try_files {path} /index.html
		file_server
	}
}

{$FO_APEX} {
	redir https://{$FO_HOST}{uri} permanent
}

{$SITE_HOST} {
	encode zstd gzip

	# Funny Multi's former address. One container serves one mount point and
	# two would split the in-memory rooms, so the old path only forwards —
	# keeping the join link's `?room=` (`handle_path` strips the prefix, so
	# {uri} is what follows it). An installed copy cannot follow this: a
	# service worker's script may not sit behind a redirect, so it must be
	# reinstalled from FM_HOST.
	redir /funny37-game https://{$FM_HOST}/ permanent
	handle_path /funny37-game/* {
		redir https://{$FM_HOST}{uri} permanent
	}

	# Funny One's former address (T-FO-6.2, until Step 60). For it a forward
	# alone is not enough: Funny One precaches everything, so a browser that
	# has been here answers the old address from its own cache and never asks
	# this server for the page — it would stay on the old build for good.
	# What it does ask for is the service worker's script (the update check,
	# which may not follow a redirect), so that one path answers with a
	# retiring worker instead: it unregisters itself, drops the caches and
	# reloads the open pages, which then meet the forward below. The file is
	# deploy/origin-root/funny1-retired/sw.js, copied by
	# deploy/ship-funny-one.sh to ./static/funny1-retired. `handle` blocks are
	# tried most specific path first, so this one wins over the forward.
	redir /funny1-game https://{$FO_HOST}/ permanent
	handle /funny1-game/sw.js {
		header Cache-Control "no-cache"
		rewrite * /sw.js
		root * /srv/static/funny1-retired
		file_server
	}
	handle_path /funny1-game/* {
		redir https://{$FO_HOST}{uri} permanent
	}

	# Anything else on this name is not a game.
	handle {
		respond "Not found" 404
	}
}

{$SITE_APEX} {
	redir https://{$SITE_HOST}{uri} permanent
}

# The Funny Family landing page (Step 72): one page per language the games
# ship — English at /, the others at /<code>/ — plus /stats/ and 404.html,
# all pre-rendered by apps/funny-family-site. No container: Caddy serves the
# files deploy/ship-funny-family.sh copies to ./static/funny-family.
{$HUB_HOST} {
	encode zstd gzip

	# The page's visit counts and the summary /stats/ reads live in the game's
	# server (analytics.ts), one store for this page and Funny Multi alike; so
	# do the gift rails its Support Author sheet shows (/api/config, Step 76).
	# Same origin, so the page needs no CORS; only these three paths, so
	# nothing else of the game's answers on this host.
	@hub_api path /api/stats /api/stats/summary /api/config
	handle @hub_api {
		reverse_proxy funny-multi:3000
	}

	handle {
		# Pages revalidate on every load, so a deploy shows at once; assets/
		# is content-hashed and never changes under a given name. The media,
		# flags and fonts are not hashed, so a day.
		@hub_pages path */ *.html
		header @hub_pages Cache-Control "no-cache"
		@hub_hashed path /assets/*
		header @hub_hashed Cache-Control "public, max-age=31536000, immutable"
		@hub_daily path /media/* /flags/* /fonts/*
		header @hub_daily Cache-Control "public, max-age=86400"

		root * /srv/static/funny-family
		file_server
	}

	# A path with no file gets the page that says so, in all its languages,
	# with the 404 status kept.
	handle_errors 404 {
		root * /srv/static/funny-family
		rewrite * /404.html
		file_server
	}
}

{$HUB_APEX} {
	redir https://{$HUB_HOST}{uri} permanent
}
