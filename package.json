{
  "name": "funny-family",
  "version": "0.1.0",
  "private": true,
  "description": "Funny Family monorepo. v1 ships Funny Multi «Чепуха 37» — a 3–7 player party game where every answer is picked from a curated pool and each story becomes an AI cartoon.",
  "license": "AGPL-3.0-only",
  "author": "michaelm",
  "repository": {
    "type": "git",
    "url": "https://github.com/oursharedcode/funny-one.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build -w packages/shared",
    "dev": "concurrently -n client,server -c blue,green \"npm:dev -w apps/funny-multi-client\" \"npm:dev -w apps/funny-multi-server\"",
    "prebuild": "npm run build -w packages/shared",
    "build": "npm run build -w apps/funny-multi-client && npm run build -w apps/funny-multi-server",
    "start": "npm run start -w apps/funny-multi-server",
    "pretest": "npm run build -w packages/shared",
    "test": "npm run test -ws --if-present",
    "test:watch": "npm run test:watch -ws --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "npm run build -w packages/shared",
    "typecheck": "npm run typecheck -ws --if-present"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
