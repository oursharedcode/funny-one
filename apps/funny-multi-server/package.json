    "@fastify/static": "^10.1.3",
    "@funny/shared": "*",
    "fastify": "^5.11.3",
    "nanoid": "^5.1.16",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "socket.io-client": "^4.8.3"
  }
}
